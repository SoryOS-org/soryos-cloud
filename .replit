modules = ["bun"]
run = "bun run dev"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["bun", "install", "--frozen-lockfile"]
env = { "CI" = "true" }

[workflows]
runButton = "SoryOS Cloud Preview"

[agent]
# Runtime is declared via modules = ["bun"] above. Replit Agent does not
# document a BUN value for this key, so the nodejs label is kept deliberately.
stack = "NODEJS_WORKSPACE"
expertMode = true
